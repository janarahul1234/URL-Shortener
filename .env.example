# ============================================================
# SHORTCIRCUIT environment — copy to .env.local and fill in.
# Find all three values in Supabase Dashboard:
#   Project Settings -> API  (URL, publishable key)
#   Project Settings -> API  (secret / service_role key — SERVER ONLY)
# ============================================================

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXX

# Server-only. NEVER expose to the browser / NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX

# Public origin used to build short URLs (set in production):
# e.g. https://short.yourdomain.com — in dev, redirects fall back to request host.
APP_BASE_URL=http://localhost:3000
